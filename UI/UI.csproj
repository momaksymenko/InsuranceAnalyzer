<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Data\Data.csproj" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Datasets\insurance.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Datasets\insurance.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\InsuranceRecordForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AnalysisForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AnalysisForm.Designer.cs">
      <DependentUpon>AnalysisForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\AnalysisForm.resx">
      <DependentUpon>AnalysisForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\InsuranceRecordForm.Designer.cs">
      <DependentUpon>InsuranceRecordForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\InsuranceRecordForm.resx">
      <DependentUpon>InsuranceRecordForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ImportOptionsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\ImportOptionsForm.Designer.cs">
      <DependentUpon>ImportOptionsForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\ImportOptionsForm.resx">
      <DependentUpon>ImportOptionsForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ExportOptionsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\ExportOptionsForm.Designer.cs">
      <DependentUpon>ExportOptionsForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\ExportOptionsForm.resx">
      <DependentUpon>ExportOptionsForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
